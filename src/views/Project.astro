---
import Base from '../layouts/Base.astro';
import Img from '../components/Img.astro';
import { PROJECTS, type Project } from '../data/projects';
import { SITE, T, localePath, href, type Lang } from '../data/site';
import { getImage } from 'astro:assets';
import { img } from '../lib/images';

interface Props { lang: Lang; project: Project }
const { lang, project: p } = Astro.props;
const t = T[lang];
const idx = PROJECTS.findIndex((x) => x.slug === p.slug);
const next = PROJECTS[(idx + 1) % PROJECTS.length];
const path = `/work/${p.slug}/`;
const url = new URL(localePath(lang, path), SITE.url).href;

const nl2br = (s: string) => s.split('\n');
const paras = (s: string) => s.split('\n\n');

// Structured data: the project as a CreativeWork with its image gallery
const pics = p.blocks.flatMap((b) =>
  b.type === 'full' || b.type === 'single' ? [b.pic] : b.type === 'pair' || b.type === 'row' ? b.pics : [],
);
const imageObjects = await Promise.all(
  pics.slice(0, 24).map(async (pic) => {
    const r = await getImage({ src: img(pic.src), width: 1600, format: 'jpg' });
    return { '@type': 'ImageObject', contentUrl: new URL(r.src, SITE.url).href, caption: pic.alt[lang], creator: { '@id': `${SITE.url}/#person` } };
  }),
);
const creativeWork = {
  '@type': 'CreativeWork',
  '@id': `${url}#work`,
  name: `${p.title}, ${p.subtitle[lang]}`,
  alternateName: p.title,
  description: p.seo[lang],
  genre: p.kind[lang],
  ...(p.year ? { dateCreated: p.year } : {}),
  inLanguage: lang === 'it' ? 'it-IT' : 'en-GB',
  url,
  creator: { '@id': `${SITE.url}/#person` },
  contributor: p.credits.filter((c) => c.value !== 'Tiziana Lisci').map((c) => ({ '@type': 'Person', name: c.value, description: c.label[lang] })),
  ...(p.slug === 'corpi-senza-volto' ? { locationCreated: { '@type': 'Place', name: 'Teatro Golden, Roma' } } : {}),
  image: imageObjects,
};
---

<Base
  lang={lang}
  path={path}
  title={`${p.title}, ${p.subtitle[lang]} | Tiziana Lisci`}
  description={p.seo[lang]}
  ogImage={p.card.src === 'vanessa/vanessa-02' ? p.card.src : p.hero.src}
  theme={p.theme}
  type="article"
  jsonld={[creativeWork]}
  breadcrumb={[{ name: 'Tiziana Lisci', path: '/' }, { name: t.work, path: '/#lavori' }, { name: p.title, path }]}
>
  <article class:list={['project', `theme-${p.theme}`, `p-${p.slug}`]}>
    <header class="p-hero">
      <div class="p-hero-media">
        <Img pic={p.hero} lang={lang} sizes="100vw" eager />
      </div>
      <div class="p-hero-text wrap">
        <p class="label">{p.n} {p.kind[lang]}{p.year ? `, ${p.year}` : ''}</p>
        <h1 class="p-title">{p.title}</h1>
        <p class="p-subtitle">{p.subtitle[lang]}</p>
      </div>
    </header>

    <section class="p-intro wrap">
      <p class="p-summary">{p.summary[lang]}</p>
      <div class="p-facts">
        <dl class="p-meta">
          {p.meta.map((m) => (
            <div><dt class="label">{m.label[lang]}</dt><dd>{m.value[lang]}</dd></div>
          ))}
        </dl>
        {p.credits.length > 0 && (
          <>
            <h2 class="label p-credits-title">{t.credits}</h2>
            <dl class="p-meta p-credits">
              {p.credits.map((c) => <div><dt class="label">{c.label[lang]}</dt><dd>{c.value}</dd></div>)}
            </dl>
          </>
        )}
      </div>
    </section>

    <div class="blocks">
      {p.blocks.map((b) => {
        switch (b.type) {
          case 'quote':
            return <blockquote class="b-quote wrap" data-reveal><p>{b.text[lang]}</p></blockquote>;
          case 'text':
            return (
              <section class="b-text wrap" data-reveal>
                {b.kicker && <p class="label kicker">{b.kicker[lang]}</p>}
                {b.title && <h2>{b.title[lang]}</h2>}
                <div class="b-text-body">{paras(b.text[lang]).map((x) => <p>{x}</p>)}</div>
              </section>
            );
          case 'poem':
            return (
              <div class:list={['b-poem wrap', `align-${b.align ?? 'left'}`]} data-reveal>
                <p>{paras(b.text[lang]).map((st, i) => <>{i > 0 && <><br /><br /></>}{nl2br(st).map((ln, j) => <>{j > 0 && <br />}{ln}</>)}</>)}</p>
              </div>
            );
          case 'chapter':
            return (
              <section class="b-chapter wrap" id={`cap-${b.n}`}>
                <div class="b-chapter-head" data-reveal>
                  <p class="label">{t.chapter} {b.n}/05</p>
                  <h2>{b.title[lang]}</h2>
                </div>
                {b.poem && (
                  <div class="b-chapter-poem" data-reveal>
                    {paras(b.poem[lang]).map((st) => <p>{nl2br(st).map((ln, j) => <>{j > 0 && <br />}{ln}</>)}</p>)}
                  </div>
                )}
              </section>
            );
          case 'full':
            return <figure class="b-full" data-reveal><Img pic={b.pic} lang={lang} sizes="100vw" /></figure>;
          case 'single':
            return (
              <figure class:list={['b-single wrap', `align-${b.align}`, `size-${b.size ?? 'm'}`]} data-reveal>
                <Img pic={b.pic} lang={lang} sizes={b.size === 'l' ? '(max-width: 760px) 100vw, 66vw' : b.size === 's' ? '(max-width: 760px) 70vw, 30vw' : '(max-width: 760px) 100vw, 48vw'} />
              </figure>
            );
          case 'pair':
            return (
              <div class="b-pair wrap" data-reveal>
                {b.pics.map((pic) => <figure><Img pic={pic} lang={lang} sizes="(max-width: 760px) 100vw, 50vw" /></figure>)}
              </div>
            );
          case 'row':
            return (
              <div class="b-row wrap" style={`--n:${b.pics.length}`} data-reveal>
                {b.pics.map((pic) => <figure><Img pic={pic} lang={lang} sizes={`(max-width: 760px) 50vw, ${Math.round(100 / b.pics.length)}vw`} /></figure>)}
              </div>
            );
          case 'columns':
            return (
              <section class="b-columns wrap" data-reveal>
                {b.kicker && <p class="label kicker">{b.kicker[lang]}</p>}
                <div class="b-columns-grid">
                  {b.items.map((it, i) => (
                    <div><p class="label muted">0{i + 1}</p><h3>{it.title[lang]}</h3><p>{it.text[lang]}</p></div>
                  ))}
                </div>
              </section>
            );
          case 'process':
            return (
              <section class="b-process wrap">
                <p class="label kicker" data-reveal>{b.kicker[lang]}</p>
                <div class="b-process-grid">
                  {b.items.map((it) => (
                    <figure data-reveal>
                      <Img pic={it.pic} lang={lang} sizes="(max-width: 760px) 100vw, 25vw" />
                      <figcaption><h3>{it.title[lang]}</h3><p>{it.text[lang]}</p></figcaption>
                    </figure>
                  ))}
                </div>
              </section>
            );
        }
      })}
    </div>

    <nav class="p-next" aria-label={t.next}>
      <a href={href(lang, `/work/${next.slug}/`)} class="p-next-link wrap">
        <span class="label muted">{t.next}</span>
        <span class="p-next-title">{next.title} <span aria-hidden="true">→</span></span>
        <span class="p-next-img" aria-hidden="true"><Img pic={next.card} lang={lang} sizes="(max-width: 760px) 40vw, 18vw" /></span>
      </a>
    </nav>
  </article>
</Base>

<style>
  .p-hero { position: relative; margin-top: calc(var(--header-h) * -1); }
  .p-hero-media :global(img) { width: 100%; height: 100svh; min-height: 520px; object-fit: cover; }
  .p-hero-media::after { content: ''; position: absolute; inset: 0; background: linear-gradient(to top, rgba(10, 9, 8, 0.75), rgba(10, 9, 8, 0) 55%); pointer-events: none; }
  .p-hero-text { position: absolute; left: 0; right: 0; bottom: clamp(24px, 4vw, 56px); color: #f1ece4; z-index: 1; }
  .p-title { font-size: clamp(56px, 13vw, 240px); font-weight: 700; letter-spacing: -0.05em; line-height: 0.85; margin: 0.12em 0 0.08em -0.04em; text-transform: uppercase; }
  .p-subtitle { font-size: clamp(22px, 2.6vw, 44px); margin: 0; }

  .p-intro { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); gap: calc(var(--gap) * 3); padding-top: clamp(56px, 8vw, 120px); padding-bottom: clamp(56px, 8vw, 120px); align-items: start; }
  .p-summary { font-size: var(--fs-lead); line-height: 1.2; letter-spacing: -0.01em; max-width: 30ch; margin: 0; }
  .p-meta { margin: 0; display: grid; gap: 0; }
  .p-credits-title { margin: clamp(28px, 3vw, 44px) 0 10px; font-weight: 400; letter-spacing: 0.03em; line-height: 1.35; }
  .p-meta div { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); gap: var(--gap); padding: 12px 0; border-top: 1px solid var(--rule); }
  .p-meta dt { color: var(--fg-muted); padding-top: 3px; }
  .p-meta dd { margin: 0; }
  @media (max-width: 760px) { .p-intro { grid-template-columns: 1fr; } }

  .blocks > * + * { margin-top: clamp(28px, 5vw, 80px); }
  figure { margin: 0; }

  .b-quote { padding-block: clamp(24px, 6vw, 100px); }
  .b-quote p { font-size: clamp(34px, 5.4vw, 96px); line-height: 1; letter-spacing: -0.035em; max-width: 18ch; margin: 0; text-wrap: balance; }

  .b-text { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr); gap: calc(var(--gap) * 2); }
  .b-text .b-text-body { max-width: 60ch; }
  .b-text-body p:first-child { font-size: var(--fs-lead); line-height: 1.25; }
  @media (max-width: 760px) { .b-text { grid-template-columns: 1fr; } }

  .b-poem p { margin: 0; font-size: clamp(18px, 1.5vw + 8px, 26px); line-height: 1.4; max-width: 38ch; }
  .b-poem.align-center { text-align: center; }
  .b-poem.align-center p { margin-inline: auto; font-size: clamp(22px, 2vw + 8px, 36px); line-height: 1.2; letter-spacing: -0.015em; }
  .b-poem.align-right p { margin-left: auto; }

  .b-chapter { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: calc(var(--gap) * 2); padding-top: clamp(80px, 14vw, 220px); border-top: 0; align-items: start; }
  .b-chapter-head { grid-column: 1 / -1; }
  .b-chapter-poem { grid-column: 2; }
  .b-chapter-head h2 { font-size: clamp(52px, 10vw, 190px); font-weight: 700; letter-spacing: -0.05em; line-height: 0.85; margin-top: 0.15em; text-transform: uppercase; }
  .b-chapter-poem p { font-size: clamp(17px, 1.2vw + 8px, 23px); line-height: 1.45; }
  @media (max-width: 760px) { .b-chapter { grid-template-columns: 1fr; } .b-chapter-poem { grid-column: 1; } }

  .b-full :global(img) { width: 100%; max-height: 120vh; object-fit: cover; }

  .b-single { display: flex; }
  .b-single.align-left { justify-content: flex-start; }
  .b-single.align-right { justify-content: flex-end; }
  .b-single.align-center { justify-content: center; }
  .b-single :global(picture) { width: 48%; }
  .b-single.size-s :global(picture) { width: 30%; }
  .b-single.size-l :global(picture) { width: 66%; }
  @media (max-width: 760px) {
    .b-single :global(picture), .b-single.size-l :global(picture) { width: 100%; }
    .b-single.size-s :global(picture) { width: 70%; }
  }

  .b-pair { display: grid; grid-template-columns: 1fr 1fr; gap: var(--gap); align-items: end; }
  .b-row { display: grid; grid-template-columns: repeat(var(--n), minmax(0, 1fr)); gap: 8px; align-items: end; }
  @media (max-width: 760px) {
    .b-pair { grid-template-columns: 1fr; }
    .b-row { grid-template-columns: 1fr 1fr; }
  }

  .b-columns { padding-top: clamp(80px, 12vw, 180px); }
  .b-columns-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: calc(var(--gap) * 2); border-top: 1px solid var(--rule); padding-top: 24px; }
  .b-columns h3, .b-process h3 { font-size: clamp(24px, 2.2vw, 38px); letter-spacing: -0.02em; margin: 0.3em 0 0.5em; }
  @media (max-width: 760px) { .b-columns-grid { grid-template-columns: 1fr; } }

  .b-process-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--gap); }
  .b-process figure :global(img) { aspect-ratio: 4 / 5; object-fit: cover; }
  .b-process figcaption p { font-size: 0.9em; color: var(--fg-muted); }
  @media (max-width: 900px) { .b-process-grid { grid-template-columns: 1fr 1fr; } }






  .p-next { margin-top: clamp(100px, 14vw, 200px); border-top: 1px solid var(--rule); }
  .p-next-link { display: grid; grid-template-columns: minmax(0, 1fr) auto; grid-template-rows: auto auto; align-items: end; gap: 10px var(--gap); padding-top: clamp(28px, 4vw, 48px); }
  .p-next-title { grid-column: 1; font-size: clamp(48px, 10vw, 190px); font-weight: 700; letter-spacing: -0.05em; line-height: 0.85; text-transform: uppercase; }
  .p-next-title span { display: inline-block; font-size: 0.5em; transition: transform 0.5s var(--ease); }
  .p-next-link:hover .p-next-title span { transform: translateX(0.3em); }
  .p-next-img { grid-column: 2; grid-row: 1 / 3; width: clamp(110px, 16vw, 260px); }

</style>
