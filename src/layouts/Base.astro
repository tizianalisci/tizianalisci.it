---
import '../styles/global.css';
import { getImage } from 'astro:assets';
import { SITE, ROLE, T, localePath, asset, type Lang } from '../data/site';
import { img } from '../lib/images';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  lang: Lang;
  /** Locale-neutral path, e.g. "/work/unholy/" */
  path: string;
  title: string;
  description: string;
  ogImage?: string;
  theme?: 'light' | 'dark';
  type?: 'website' | 'article';
  jsonld?: Record<string, unknown>[];
  breadcrumb?: { name: string; path: string }[];
  noindex?: boolean;
  pageType?: 'WebPage' | 'ProfilePage' | 'CollectionPage';
}

const { lang, path, title, description, ogImage = 'corpi/cover', theme = 'light', type = 'website', jsonld = [], breadcrumb = [], noindex = false, pageType = 'WebPage' } = Astro.props;

const abs = (p: string) => new URL(p, SITE.url).href;
const itUrl = abs(localePath('it', path));
const enUrl = abs(localePath('en', path));
const canonical = lang === 'it' ? itUrl : enUrl;
const og = await getImage({ src: img(ogImage), width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 82 });
const ogUrl = abs(og.src);
const portrait = await getImage({ src: img('about/tiziana-01'), width: 800, format: 'jpg' });

const person = {
  '@type': 'Person',
  '@id': `${SITE.url}/#person`,
  name: SITE.name,
  givenName: 'Tiziana',
  familyName: 'Lisci',
  jobTitle: ROLE[lang],
  description: lang === 'it'
    ? 'Creative director e producer nata in Sardegna e basata a Roma. Racconta persone, corpi e storie attraverso fotografia ed editoria.'
    : 'Creative director and producer born in Sardinia and based in Rome. She tells stories of people and bodies through photography and publishing.',
  url: `${SITE.url}/`,
  email: `mailto:${SITE.email}`,
  image: abs(portrait.src),
  sameAs: [SITE.instagramUrl],
  homeLocation: { '@type': 'Place', name: 'Roma, Lazio, Italia', address: { '@type': 'PostalAddress', addressLocality: 'Roma', addressRegion: 'Lazio', addressCountry: 'IT' } },
  birthPlace: { '@type': 'Place', name: 'Sardegna, Italia' },
  alumniOf: { '@type': 'CollegeOrUniversity', name: SITE.school.name, url: SITE.school.url, address: { '@type': 'PostalAddress', addressLocality: 'Roma', addressCountry: 'IT' } },
  knowsAbout: ['Creative direction', 'Art direction', 'Production', 'Fashion communication', 'Fashion styling', 'Editorial photography', 'Photobook design', 'Direzione creativa', 'Comunicazione moda'],
};

const graph = [
  person,
  {
    '@type': 'WebSite',
    '@id': `${SITE.url}/#website`,
    url: `${SITE.url}/`,
    name: 'Tiziana Lisci',
    description: lang === 'it' ? 'Portfolio di Tiziana Lisci, Creative Director & Producer a Roma.' : 'Portfolio of Tiziana Lisci, Creative Director & Producer in Rome.',
    inLanguage: ['it-IT', 'en-GB'],
    publisher: { '@id': `${SITE.url}/#person` },
  },
  {
    '@type': pageType,
    '@id': `${canonical}#webpage`,
    url: canonical,
    name: title,
    description,
    inLanguage: lang === 'it' ? 'it-IT' : 'en-GB',
    isPartOf: { '@id': `${SITE.url}/#website` },
    about: { '@id': `${SITE.url}/#person` },
    ...(pageType === 'ProfilePage' ? { mainEntity: { '@id': `${SITE.url}/#person` } } : {}),
    primaryImageOfPage: ogUrl,
    ...(breadcrumb.length
      ? {
          breadcrumb: {
            '@type': 'BreadcrumbList',
            itemListElement: breadcrumb.map((b, i) => ({ '@type': 'ListItem', position: i + 1, name: b.name, item: abs(localePath(lang, b.path)) })),
          },
        }
      : {}),
  },
  ...jsonld,
];
const t = T[lang];
---

<!doctype html>
<html lang={lang} data-theme={theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="it" href={itUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={itUrl} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="author" content="Tiziana Lisci" />
    <meta name="theme-color" content={theme === 'dark' ? '#0e0c0a' : '#f3f1ec'} />
    <link rel="icon" href={asset('/favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={asset('/apple-touch-icon.png')} />
    <link rel="manifest" href={asset('/site.webmanifest')} />
    <link rel="sitemap" href={asset('/sitemap-index.xml')} />
    <link rel="alternate" type="text/plain" href={asset('/llms.txt')} title="llms.txt" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Tiziana Lisci" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={lang === 'it' ? 'it_IT' : 'en_GB'} />
    <meta property="og:locale:alternate" content={lang === 'it' ? 'en_GB' : 'it_IT'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />

    <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': graph })} />
    <script is:inline>document.documentElement.classList.add('js')</script>
  </head>
  <body>
    <a class="skip" href="#main">{t.skip}</a>
    <Header lang={lang} path={path} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
    <script>
      const els = document.querySelectorAll<HTMLElement>('[data-reveal]');
      if ('IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const io = new IntersectionObserver(
          (entries) => entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); } }),
          { rootMargin: '0px 0px -8% 0px' },
        );
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add('is-in'));
      }
    </script>
  </body>
</html>
